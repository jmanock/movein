# REQUIRED in production; optional in development. Defaults to ./data/movein.sqlite relative to the application directory.
# When set, this value must be an absolute path owned by the PM2 application user.
DATABASE_PATH=

# Required in production to enable Google Analytics 4. Analytics remains off in local development by default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional local-only diagnostics. Use deliberately so development traffic is not mixed into production reports.
# NEXT_PUBLIC_GA_ENABLE_DEV=true
NEXT_PUBLIC_GA_DEBUG=false

# Receipt interpretation: choose disabled or ollama explicitly; never falls back to demo.
RECEIPT_EXTRACTOR=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Choose a locally installed vision model; no model is downloaded automatically.
OLLAMA_RECEIPT_MODEL=
# Includes model availability check, model loading, and extraction (1-600 seconds).
OLLAMA_RECEIPT_TIMEOUT_MS=180000
# Development-only diagnostics in the review screen. Never logs raw model output/images.
RECEIPT_EXTRACTION_DEBUG=false
# To explicitly use the fixture provider in development: RECEIPT_EXTRACTOR=demo

# Compare the preserved v1 baseline with v2 intelligence (default).
RECEIPT_PROMPT_VERSION=movein-receipt-v2


# Authentication (Better Auth 1.7.7); no default production identity or email fallback.
# Generate a private secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Root origin only. Production requires HTTPS; development requires loopback.
BETTER_AUTH_URL=
# smtp for production. console is allowed only in development with explicit logging opt-in.
AUTH_EMAIL_MODE=
AUTH_EMAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
# true for implicit TLS (usually 465); false requires STARTTLS (usually 587).
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_DEV_LOG_MAGIC_LINKS=false
# Legacy receipt test mode, only development/loopback and with no auth configuration.
AUTH_DEV_HOUSEHOLD=false
# npm run dev:auth uses this port and disables legacy access.
AUTH_DEV_PORT=3007
