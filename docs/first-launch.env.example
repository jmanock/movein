# First staged launch: copy privately to /etc/movein/movein.env, mode 0600.
# Fill every blank required value. This template is not runnable until filled.
NODE_ENV=production
PORT=3006
# Must match ecosystem.config.cjs and be on persistent local disk.
DATABASE_PATH=/var/lib/movein/movein.sqlite
# Generate a private stable random secret; do not commit it.
BETTER_AUTH_SECRET=
# Exact approved HTTPS root origin, e.g. https://movein.guide; no path/query.
BETTER_AUTH_URL=
AUTH_EMAIL_MODE=smtp
AUTH_EMAIL_FROM=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
# false requires STARTTLS; for implicit TLS port 465 set true.
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
# Deliberate first-launch mode: private records work, receipt scanning unavailable.
RECEIPT_EXTRACTOR=disabled
# Match approved public GA ID / existing PM2 config before build.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_DEBUG=false
NEXT_PUBLIC_GA_ENABLE_DEV=false
AUTH_DEV_LOG_MAGIC_LINKS=false
AUTH_DEV_HOUSEHOLD=false
RECEIPT_EXTRACTION_DEBUG=false
# No Ollama URL/model/timeout is needed while disabled.
